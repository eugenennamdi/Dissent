# Dissent Environment Variables (Template)
# Copy to .env.local for local development. Never commit secrets.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase 1 Bitget market research uses public, read-only endpoints and needs no credentials.
# The adapter pins requests to https://api.bitget.com rather than accepting an arbitrary host.

# AI Inference Providers (Tomorrow's orchestration phase)
# One or more of the following may be configured:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
