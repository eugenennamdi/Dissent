# Dissent Environment Variables (Template)
# Copy to .env.local for local development. Never commit secrets.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cost-bearing research requests fail closed until deliberately enabled.
# Enable only after configuring deployment-level WAF rate limiting.
RESEARCH_API_ENABLED=false

# Phase 1 Bitget market research uses public, read-only endpoints and needs no credentials.
# The adapter pins requests to https://api.bitget.com rather than accepting an arbitrary host.

# Phase 2 semantic analysis (server-only DeepSeek Responses API)
DEEPSEEK_API_KEY=
# Optional; defaults to the bounded model selected for this phase.
DEEPSEEK_MODEL=deepseek-flash
