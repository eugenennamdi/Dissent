# Dissent Environment Variables (Template)
# Copy to .env.local for local development. Never commit secrets.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bitget Market Data (Restricted read-only API access recommended)
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
BITGET_API_BASE_URL=https://api.bitget.com

# AI Inference Providers (Tomorrow's orchestration phase)
# One or more of the following may be configured:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
